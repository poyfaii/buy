{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buy",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maedon-db",
      "database_id": "7e13e9cb-49bc-4f89-9b9a-24d336bcc139"
    }
  ],
  "vars": {
    "APPS_URL": "https://script.google.com/macros/s/AKfycbwpyOWsntMprTiFuwFIh174PJw-RZnMgD2YFlbPPdUCzu5JmRjQVUbXbesLw0jqmw99/exec"
  },
  "triggers": { "crons": ["0 9 * * *"] }
}
